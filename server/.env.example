# "development" | "staging" | "production".
# In production the app refuses to start on the default SECRET_KEY or on
# SQLite, closes /docs, and sends HSTS. Leave it as development locally.
ENVIRONMENT=development

# Leave DATABASE_URL unset to use the local SQLite dev database (hrdesktimesol.db).
# Postgres (production target):
# DATABASE_URL=postgresql+psycopg://hrdesktimesol:hrdesktimesol@localhost:5432/hrdesktimesol

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- multi-tenancy ----------------------------------------------------------
# Tenants live at <slug>.<BASE_DOMAIN>. In development *.localhost resolves to
# 127.0.0.1 in every modern browser, so demo.localhost works with no DNS setup.
BASE_DOMAIN=localhost
MARKETING_HOST=app
PUBLIC_SCHEME=http
PUBLIC_PORT=5173

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_SUBDOMAINS=true

# --- storage ----------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_SCREENSHOT_BYTES=5242880

# --- agent downloads ---------------------------------------------------------
# Where the packaged agent bundles live, for the console's Employees → Install
# agent download. Defaults to ../agent/dist, so a checkout serves whatever the
# build script last produced. Docker sets it to /data/agent.
# A bundle's filename must say its platform (windows / macos / linux) or the
# console will not offer it — see app/services/agentdist.py.
# AGENT_DIST_DIR=./agent-dist
#
# What the employee types at the agent's setup prompt. Leave blank and the
# console uses the address it is being viewed on, which is correct whenever the
# console and API share a host. Set it only when they do not.
# AGENT_SERVER_URL=http://103.59.180.126:4200
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=            # set for MinIO / R2 / Wasabi
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- payments (Razorpay) ----------------------------------------------------
# Leave blank in development: signup then runs in simulated mode, so the whole
# flow is testable without credentials. RAZORPAY_LIVE=true makes the app refuse
# to simulate, so production cannot silently fall back to fake payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LIVE=false

# --- email ------------------------------------------------------------------
# Not configured here. The outbound mail connector lives in the platform console
# (Super Admin -> Email connector) and is stored in the database, so it can be
# changed without shell access and without restarting the API. The password is
# encrypted at rest with a key derived from SECRET_KEY — rotating that secret
# means re-entering the SMTP password.

# --- limits -----------------------------------------------------------------
TRIAL_DAYS=14
